NODE_ENV=production
PORT=3000
# Origine du frontend autorisée (CORS), ex. http://localhost:5173 en développement
ALLOWED_ORIGINS=http://localhost:5173
# Nombre exact de proxys de confiance devant Express. Laisser à 0 sans proxy.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://bunec:CHANGE_ME@127.0.0.1:5432/bunec
# Décommentez uniquement si le serveur PostgreSQL exige TLS.
# PGSSLMODE=require
BUNEC_SESSION_SECRET=replace-with-long-random-secret
BUNEC_ADMIN_USERNAME=admin
BUNEC_ADMIN_PASSWORD_SALT=replace-with-random-salt
BUNEC_ADMIN_PASSWORD_HASH=replace-with-pbkdf2-sha256-hash
